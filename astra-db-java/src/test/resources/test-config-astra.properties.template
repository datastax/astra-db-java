# =============================================================================
# Astra Cloud Test Configuration - TEMPLATE
# =============================================================================
# Copy this file to test-config-astra.properties and fill in your credentials.
# The test-config-astra.properties file is gitignored to protect your token.
#
# To get your Astra token:
#   1. Go to https://astra.datastax.com
#   2. Navigate to your database
#   3. Go to Connect > Generate Token
#   4. Copy the token (starts with AstraCS:...)
# =============================================================================

test.environment=astra_dev

# Your Astra application token (required)
astra.token=AstraCS:YOUR_TOKEN_HERE

# Cloud provider: GCP, AWS, or AZURE
astra.cloud.provider=GCP

# Region (must match your database's region)
astra.cloud.region=us-east1

# Optional: explicit Astra DB Data API URL.
# When provided, integration tests connect to this database directly
# and do not create a database from environment/provider/region.
# Example:
# astra.db.url=https://<db-id>-<region>.apps.astra.datastax.com
#astra.db.url=
